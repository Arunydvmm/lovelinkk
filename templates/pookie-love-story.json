  "metadata": {
    "id": "pookie-love-story",
    "name": "Pookie Love Story",
    "badge": "🐱 Pookie",
    "description": "A cute, funny and emotional love story on a checkered red background with floating hearts, a photo gallery, love letter, memory timeline, music player, certificate and a confetti finale. Perfect for anniversaries, Valentine's Day, and spontaneous surprises.",
    "category": "romantic",
    "subcategory": "cute",
    "mood": [
      "cute",
      "romantic",
      "funny",
      "emotional"
    ],
    "style": [
      "minimal",
      "premium",
      "interactive",
      "mobile-first"
    ],
    "previewImage": "https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?q=80&w=1000&auto=format&fit=crop",
    "totalPages": 9
  },
  "theme": {
    "background": "radial-gradient(ellipse at center, rgba(214,40,57,0) 0%, rgba(0,0,0,0.18) 100%), conic-gradient(#C01F30 25%, #D62839 0 50%, #C01F30 0 75%, #D62839 0) 0 0 / 80px 80px",
    "accent": "#FF4D6A",
    "headingColor": "#FFFFFF",
    "textColor": "#FFE4E8",
    "cardBg": "rgba(122,16,32,0.86)",
    "cardBorder": "rgba(255,255,255,0.40)",
    "fontSerif": "'Caveat', 'Patrick Hand', 'Nunito', Georgia, cursive",
    "fontSans": "'Nunito', 'Varela Round', system-ui, sans-serif",
    "particle": "❤️",
    "particleCount": 12
  },
  "sections": [
    {
      "id": "hero",
      "type": "hero",
      "animation": "zoomIn",
      "showProfilePicture": true,
      "showParticles": true,
      "buttonLabel": "YES 💖"
    },
    {
      "id": "gallery",
      "type": "gallery",
      "animation": "fadeUp",
      "layout": "grid",
      "showCaptions": true,
      "showDates": true,
      "nextLabel": "Read my letter 💌"
    },
    {
      "id": "letter",
      "type": "letter",
      "animation": "slideLeft",
      "showSignature": true,
      "nextLabel": "Our memories 🕰️"
    },
    {
      "id": "timeline",
      "type": "timeline",
      "animation": "fadeUp",
      "showPhotos": true,
      "nextLabel": "Keep going 💕"
    },
    {
      "id": "quotes",
      "type": "quotes",
      "animation": "fadeUp",
      "nextLabel": "Continue 💕"
    },
    {
      "id": "countdown",
      "type": "countdown",
      "animation": "fadeUp",
      "label": "Counting Down To Our Day",
      "nextLabel": "Our song 🎵"
    },
    {
      "id": "music",
      "type": "music",
      "animation": "fadeIn",
      "showWaveform": true,
      "autoplay": false,
      "nextLabel": "My gift to you 🏆"
    },
    {
      "id": "certificate",
      "type": "certificate",
      "animation": "zoomIn",
      "allowDownload": true,
      "nextLabel": "The finale 🎆"
    },
    {
      "id": "ending",
      "type": "ending",
      "animation": "zoomIn",
      "showReplay": true,
      "showShare": true,
      "showConfetti": true
    }
  ],
