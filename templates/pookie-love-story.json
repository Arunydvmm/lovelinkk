  "globalAnimation": {
    "pageTransition": {
      "type": "fade",
      "duration": 0.5,
      "easing": "easeOut"
    },
    "heartFloat": {
      "yFrom": "108vh",
      "yTo": "-8vh",
      "rotate": 25,
      "duration": { "min": 12, "max": 22 },
      "delay":   { "step": 0.7 },
      "loop": true
    },
    "flowerBloom": {
      "initialScale": 0,
      "finalScale": 1,
      "duration": 0.6,
      "easing": "spring",
      "staggerDelay": 0.12
    },
    "fadeIn": {
      "initialOpacity": 0,
      "finalOpacity": 1,
      "duration": 0.55,
      "easing": "easeOut"
    },
    "zoom": {
      "initialScale": 0.88,
      "finalScale": 1,
      "duration": 0.5,
      "easing": "easeOut"
    },
    "slideUp": {
      "initialY": 36,
      "finalY": 0,
      "initialOpacity": 0,
      "duration": 0.55,
      "easing": "easeOut"
    },
    "bounce": {
      "type": "bounce",
      "duration": 0.6,
      "times": [0, 0.4, 0.7, 1],
      "values": [1, 1.15, 0.95, 1]
    },
    "pulse": {
      "scale": [1, 1.08, 1],
      "duration": 1.4,
      "loop": true,
      "easing": "easeInOut"
    },
    "typing": {
      "type": "typing",
      "charDelay": 0.022,
      "cursorBlink": true,
      "cursorChar": "|"
    },
    "confettiBurst": {
      "particleCount": 120,
      "spread": 120,
      "origin": { "y": 0.55 },
      "colors": ["#D62839", "#FFB6C1", "#F5C842", "#FFFFFF", "#FF6B7A"]
    },
    "confettiGold": {
      "particleCount": 90,
      "spread": 100,
      "origin": { "y": 0.5 },
      "colors": ["#F5C842", "#FDE68A", "#FFFFFF", "#D62839", "#FFB6C1"],
      "shapes": ["circle", "star"]
    },
    "fireworks": {
      "type": "fireworks",
      "bursts": 5,
      "interval": 600,
      "colors": ["#D62839", "#F5C842", "#FFB6C1", "#FFFFFF", "#FF6B7A"]
    },
    "sparkle": {
      "color": "#F5C842",
      "size": 14,
      "count": 8,
      "duration": 1.2,
      "loop": true
    },
    "buttonEntrance": {
      "initialY": 18,
      "initialOpacity": 0,
      "duration": 0.45,
      "staggerDelay": 0.12
    }
  },

  "soundEffects": {
    "buttonClick":    { "id": "sfx-click",    "type": "tone", "frequency": 880, "duration": 0.08 },
    "heartPop":       { "id": "sfx-heart",    "type": "tone", "frequency": 660, "duration": 0.12 },
    "confettiBurst":  { "id": "sfx-confetti", "type": "tone", "frequency": 1046, "duration": 0.18 },
    "no":             { "id": "sfx-no",       "type": "tone", "frequency": 220, "duration": 0.20 }
  },

  "music": {
