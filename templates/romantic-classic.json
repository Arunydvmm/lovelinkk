{
  "metadata": {
    "id": "romantic-classic-v1",
    "name": "Romantic Classic",
    "version": "1.0.0",
    "description": "A timeless romantic surprise journey — welcome, gift reveal, love letter, reasons, memories, music, certificate and a final farewell. Perfect for anniversaries, birthdays, and spontaneous love gestures.",
    "badge": "❤️ Classic",
    "badgeBg": "bg-rose-100 text-rose-700",
    "category": "romantic",
    "tags": ["anniversary", "birthday", "valentine", "love", "classic"],
    "previewImage": "{{coverImage}}",
    "author": "LoveLink",
    "createdAt": "2025-01-01T00:00:00.000Z",
    "totalPages": 9
  },

  "theme": {
    "background": {
      "type": "gradient",
      "colors": ["#fce7f3", "#fff1f2", "#fce7f3"],
      "direction": "135deg"
    },
    "ambientOverlay": {
      "type": "radial-gradient",
      "colors": ["rgba(251,207,232,0.5)", "rgba(255,241,242,0.8)", "rgba(252,231,243,1)"],
      "position": "ellipse at top"
    },
    "colors": {
      "primary": "#e11d48",
      "primaryLight": "#fb7185",
      "primaryDark": "#9f1239",
      "secondary": "#ec4899",
      "surface": "rgba(255,255,255,0.92)",
      "surfaceBlur": "rgba(255,255,255,0.85)",
      "border": "#fecdd3",
      "borderStrong": "#fda4af",
      "text": "#4c0519",
      "textMuted": "#9f1239",
      "textSubtle": "rgba(159,18,57,0.7)",
      "badge": "#fecdd3",
      "badgeText": "#9f1239",
      "buttonPrimary": "linear-gradient(135deg, #e11d48, #ec4899, #e11d48)",
      "buttonSecondary": "transparent",
      "buttonSecondaryBorder": "#fda4af",
      "buttonSecondaryText": "#be123c",
      "progressBar": "linear-gradient(90deg, #e11d48, #ec4899)",
      "progressTrack": "#fce7f3",
      "confettiColors": ["#f43f5e", "#ec4899", "#fb7185", "#ffffff", "#fda4af"]
    },
    "typography": {
      "fontFamily": {
        "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "serif": "Georgia, 'Times New Roman', serif"
      },
      "sizes": {
        "hero": "2.25rem",
        "heading": "1.75rem",
        "subheading": "1.25rem",
        "body": "0.9375rem",
        "small": "0.8125rem",
        "caption": "0.6875rem",
        "badge": "0.6875rem"
      },
      "weights": {
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      }
    },
    "spacing": {
      "pagePadding": "1.25rem",
      "cardPadding": "1.5rem",
      "sectionGap": "1.5rem",
      "elementGap": "1rem"
    },
    "radius": {
      "card": "1.25rem",
      "pill": "9999px",
      "button": "9999px",
      "image": "0.75rem",
      "avatar": "9999px"
    },
    "shadows": {
      "card": "0 20px 60px rgba(225,29,72,0.12), 0 4px 16px rgba(0,0,0,0.06)",
      "button": "0 8px 24px rgba(225,29,72,0.30)",
      "avatar": "0 20px 60px rgba(225,29,72,0.20), 0 4px 16px rgba(0,0,0,0.08)",
      "music": "0 8px 32px rgba(225,29,72,0.18)"
    },
    "glassmorphism": {
      "background": "rgba(255,255,255,0.88)",
      "backdropBlur": "16px",
      "border": "1px solid rgba(254,205,211,0.8)"
    },
    "decorations": {
      "floatingHearts": true,
      "heartCount": 10,
      "heartColors": ["rgba(251,113,133,0.30)", "rgba(236,72,153,0.20)"],
      "heartSizes": [20, 27, 34, 20, 20, 27, 27, 34, 27, 20],
      "ambientBlobs": true,
      "blobColors": ["rgba(252,207,232,0.40)", "rgba(251,207,232,0.30)"],
      "progressDots": true
    },
    "stickers": ["❤️", "💕", "✨", "🌹", "💖", "🎁", "🏆", "🎵"],
    "emojis": {
      "love": "❤️",
      "sparkle": "✨",
      "gift": "🎁",
      "music": "🎵",
      "certificate": "🏆",
      "flower": "🌹",
      "star": "⭐"
    }
  },

  "globalAnimation": {
    "pageTransition": {
      "type": "fade",
      "duration": 0.55,
      "easing": "easeOut"
    },
    "floatingHearts": {
      "type": "heartFloat",
      "duration": { "min": 14, "max": 26.5 },
      "delay": { "step": 0.9 },
      "yFrom": "105vh",
      "yTo": "-10vh",
      "rotate": 360,
      "loop": true
    },
    "cardEntrance": {
      "type": "zoom",
      "initialScale": 0.92,
      "initialY": 20,
      "duration": 0.6
    },
    "slideEntrance": {
      "type": "slide",
      "initialY": 30,
      "duration": 0.6
    },
    "flashCard": {
      "type": "slide",
      "enterX": 60,
      "exitX": -60,
      "rotateY": 15,
      "duration": 0.35,
      "easing": "easeOut",
      "swipeThreshold": 40
    },
    "confetti": {
      "particleCount": 80,
      "spread": 100,
      "origin": { "y": 0.6 },
      "colors": ["#f43f5e", "#ec4899", "#fb7185", "#ffffff"]
    },
    "confettiMini": {
      "particleCount": 20,
      "spread": 50,
      "origin": { "y": 0.7 },
      "colors": ["#f43f5e", "#fb7185"]
    },
    "progressBar": {
      "type": "slide",
      "duration": 0.4
    },
    "waveform": {
      "type": "pulse",
      "bars": 20,
      "heightRange": [8, 45],
      "duration": { "min": 0.6, "max": 1.2 },
      "delay": { "step": 0.05 },
      "barWidth": "0.375rem",
      "barColor": "#fda4af"
    },
    "avatarGlow": {
      "type": "pulse",
      "loop": true,
      "colors": ["#f43f5e", "#ec4899"]
    },
    "lightboxFade": {
      "type": "fade",
      "duration": 0.25
    }
  },

  "music": {
    "variable": "{{music}}",
    "autoPlayOnPageTwo": true,
    "loop": true,
    "defaultVolume": 0.5,
    "showFloatingPill": true,
    "pill": {
      "position": "top-right",
      "offset": "1rem",
      "glassmorphism": true
    },
    "controls": ["play", "pause", "mute", "unmute"]
  },

  "variables": [
    { "key": "yourName",       "label": "Your Name",           "type": "text",      "required": true,  "placeholder": "Priya" },
    { "key": "partnerName",    "label": "Partner / Recipient", "type": "text",      "required": true,  "placeholder": "Kabir" },
    { "key": "title",          "label": "Story Title",         "type": "text",      "required": true,  "placeholder": "Our Love Story ❤️" },
    { "key": "welcomeMessage", "label": "Welcome Message",     "type": "text",      "required": false, "placeholder": "Welcome to our special place ❤️" },
    { "key": "loveLetter",     "label": "Love Letter",         "type": "textarea",  "required": true,  "placeholder": "You are the best part of my life…" },
    { "key": "finalMessage",   "label": "Final Message",       "type": "text",      "required": false, "placeholder": "Thank you for being mine. I love you endlessly! ❤️" },
    { "key": "reasons",        "label": "Reasons I Love You",  "type": "array",     "required": true,  "min": 1, "max": 15 },
    { "key": "coverImage",     "label": "Cover Photo",         "type": "image",     "required": false, "fallback": "{{gallery[0]}}" },
    { "key": "gallery",        "label": "Memory Photos",       "type": "imageArray","required": true,  "min": 1, "max": 20 },
    { "key": "music",          "label": "Background Music",    "type": "music",     "required": false },
    { "key": "date",           "label": "Certificate Date",    "type": "date",      "required": false, "fallback": "today" },
    { "key": "certificateType","label": "Certificate Type",    "type": "select",    "required": true,  "options": ["Girlfriend","Boyfriend","Best Friend","Husband","Wife"] },
    { "key": "certificateName","label": "Certificate Recipient","type": "text",     "required": false, "fallback": "{{partnerName}}" },
    { "key": "presentedBy",    "label": "Presented By",        "type": "text",      "required": false, "fallback": "{{yourName}}" },
    { "key": "personalMessage","label": "Personal Message on Certificate","type": "text","required": false, "placeholder": "You are my forever and always…" },
    { "key": "award",          "label": "Award Title",         "type": "select",    "required": false, "options": ["Best Girlfriend ❤️","Best Boyfriend ❤️","Best Partner ❤️"], "fallback": "Best Partner ❤️" }
  ],

  "pages": [
    {
      "id": "page-1",
      "pageNumber": 1,
      "key": "welcome",
      "label": "Welcome",
      "component": "Cover",
      "showInProgress": false,
      "transition": {
        "enter": { "type": "zoom", "initialScale": 0.92, "initialY": 20, "duration": 0.6 },
        "exit":  { "type": "zoom", "exitScale": 0.92,   "exitY": -20,   "duration": 0.6 }
      },
      "layout": {
        "alignment": "center",
        "direction": "column",
        "justify": "center",
        "gap": "1.5rem",
        "paddingY": "5rem"
      },
      "content": {
        "avatar": {
          "src": "{{coverImage}}",
          "fallback": "{{gallery[0]}}",
          "shape": "circle",
          "size": { "default": "11rem", "sm": "13rem" },
          "borderWidth": "4px",
          "borderColor": "#fda4af",
          "innerPadding": "0.25rem",
          "background": "#ffffff",
          "glow": {
            "enabled": true,
            "colors": ["#f43f5e", "#ec4899"],
            "blur": "1.25rem",
            "opacity": 0.70,
            "animation": "pulse"
          },
          "overlay": {
            "gradient": "from-rose-950/60 via-transparent to-transparent",
            "icon": "heart",
            "iconSize": 28,
            "iconColor": "#f43f5e",
            "iconAnimation": "bounce"
          },
          "hoverScale": 1.05,
          "hoverDuration": 700
        },
        "badge": {
          "text": "✨ A Special Digital Surprise",
          "style": "pill",
          "background": "rgba(254,205,211,0.70)",
          "border": "#fda4af",
          "textColor": "#9f1239"
        },
        "heading": {
          "text": "{{yourName}} & {{partnerName}}",
          "fontFamily": "sans",
          "fontSize": "hero",
          "fontWeight": "extrabold",
          "color": "#4c0519"
        },
        "subtitle": {
          "text": "\"{{title}}\"",
          "fontFamily": "serif",
          "fontStyle": "italic",
          "fontSize": "body",
          "color": "#9f1239"
        },
        "messageCard": {
          "text": "{{welcomeMessage}}",
          "fallback": "Welcome to our special digital memory book ❤️",
          "glassmorphism": true,
          "textAlign": "center",
          "fontWeight": "medium",
          "fontSize": "body"
        }
      },
      "actions": [
        {
          "id": "btn-open",
          "type": "button",
          "variant": "primary",
          "label": "Open Our Story",
          "iconLeft": "heart",
          "iconRight": "chevron-right",
          "fullWidth": true,
          "animation": { "hover": "scale:1.03", "tap": "scale:0.97" },
          "onClick": [
            { "action": "navigate", "target": "next" }
          ]
        }
      ]
    },

    {
      "id": "page-2",
      "pageNumber": 2,
      "key": "cover",
      "label": "Gift Reveal",
      "component": "CuteCatGift",
      "showInProgress": true,
      "transition": {
        "enter": { "type": "zoom", "initialScale": 0.92, "duration": 0.5 },
        "exit":  { "type": "zoom", "exitScale": 0.92,   "duration": 0.5 }
      },
      "layout": { "alignment": "center", "direction": "column", "justify": "center" },
      "content": {
        "catAnimation": {
          "states": ["sleeping","wake","blink","smile","tail","heart","giftAppears","opened"],
          "timing": [0, 1500, 2800, 4000, 5200, 6400, 7600],
          "greeting": "{{partnerName}}"
        }
      },
      "onEnter": [
        { "action": "playMusic" },
        { "action": "confetti", "preset": "confetti" }
      ],
      "actions": [
        {
          "id": "btn-gift-skip",
          "type": "button",
          "variant": "secondary",
          "label": "Skip →",
          "position": "bottom",
          "onClick": [{ "action": "navigate", "target": "next" }]
        },
        {
          "id": "btn-gift-back",
          "type": "button",
          "variant": "ghost",
          "label": "← Back",
          "position": "bottom",
          "onClick": [{ "action": "navigate", "target": "prev" }]
        }
      ]
    },

    {
      "id": "page-3",
      "pageNumber": 3,
      "key": "letter",
      "label": "Letter",
      "component": "LoveLetter",
      "showInProgress": true,
      "transition": {
        "enter": { "type": "slide", "initialY": 30, "duration": 0.6 },
        "exit":  { "type": "slide", "exitY": -30,  "duration": 0.6 }
      },
      "layout": { "alignment": "center", "direction": "column", "gap": "1.25rem" },
      "content": {
        "badge": {
          "text": "From My Heart",
          "style": "pill"
        },
        "heading": {
          "text": "A Letter For You",
          "fontFamily": "serif",
          "icon": "heart"
        },
        "card": {
          "glassmorphism": true,
          "border": "#fda4af",
          "decorativeBlob": { "position": "top-right", "color": "rgba(251,207,232,0.40)", "blur": "2rem" },
          "salutation": {
            "text": "My Dearest {{partnerName}},",
            "fontFamily": "serif",
            "fontWeight": "bold",
            "color": "#be123c"
          },
          "body": {
            "text": "{{loveLetter}}",
            "fallback": "You are the best part of my life. Every moment spent with you is a blessing that I cherish deeply. I love you today, tomorrow, and forever.",
            "fontFamily": "serif",
            "fontStyle": "italic",
            "fontWeight": "medium",
            "whiteSpace": "pre-line"
          },
          "signature": {
            "caption": "With all my love,",
            "name": "{{yourName}}",
            "fontFamily": "serif",
            "align": "right",
            "divider": true
          }
        }
      },
      "actions": [
        {
          "id": "btn-letter-next",
          "type": "button",
          "variant": "primary",
          "label": "Reasons Why I Love You →",
          "onClick": [{ "action": "navigate", "target": "next" }]
        },
        {
          "id": "btn-letter-back",
          "type": "button",
          "variant": "secondary",
          "label": "← Back",
          "onClick": [{ "action": "navigate", "target": "prev" }]
        }
      ]
    },

    {
      "id": "page-4",
      "pageNumber": 4,
      "key": "reasons",
      "label": "Reasons",
      "component": "MemoryCard",
      "showInProgress": true,
      "transition": {
        "enter": { "type": "zoom", "initialScale": 0.95, "duration": 0.5 },
        "exit":  { "type": "zoom", "exitScale": 0.95,   "duration": 0.5 }
      },
      "layout": { "alignment": "center", "direction": "column", "gap": "1.25rem" },
      "content": {
        "badge": { "text": "Reasons Why I Love You", "style": "pill" },
        "heading": {
          "template": "Reason {{currentIndex + 1}} of {{total}}",
          "fontFamily": "serif"
        },
        "progressDots": {
          "enabled": true,
          "activeColor": "#e11d48",
          "inactiveColor": "#fecdd3",
          "completedColor": "#fda4af",
          "activeSize": { "width": "1rem", "height": "0.625rem" },
          "dotSize": "0.5rem"
        },
        "flashCard": {
          "data": "{{reasons}}",
          "glassmorphism": true,
          "background": "linear-gradient(135deg, #fff1f2, #ffffff, #fdf2f8)",
          "border": "#fecdd3",
          "borderWidth": "2px",
          "minHeight": "12.5rem",
          "padding": "1.75rem 2rem",
          "decorBlobs": [
            { "position": "top-right", "color": "rgba(252,207,232,0.30)", "blur": "2rem" },
            { "position": "bottom-left", "color": "rgba(251,207,232,0.30)", "blur": "1.25rem" }
          ],
          "icon": {
            "type": "heart",
            "background": "linear-gradient(135deg, #e11d48, #ec4899)",
            "size": 22,
            "color": "#ffffff"
          },
          "indexBadge": { "template": "#{{currentIndex + 1}}", "style": "pill" },
          "text": {
            "template": "\"{{item}}\"",
            "fontFamily": "serif",
            "fontStyle": "italic",
            "fontWeight": "medium",
            "fontSize": "body"
          },
          "swipe": {
            "enabled": true,
            "threshold": 40
          },
          "animation": {
            "enter": { "type": "slide", "x": 60, "rotateY": 15, "duration": 0.35 },
            "exit":  { "type": "slide", "x": -60,"rotateY": -15,"duration": 0.35 }
          }
        }
      },
      "actions": [
        {
          "id": "btn-reason-prev",
          "type": "button",
          "variant": "secondary",
          "label": "← Previous",
          "iconLeft": "arrow-left",
          "disabled": "{{currentIndex === 0}}",
          "onClick": [{ "action": "prevCard" }]
        },
        {
          "id": "btn-reason-next",
          "type": "button",
          "variant": "primary",
          "label": "Next",
          "iconRight": "arrow-right",
          "showWhen": "{{currentIndex < total - 1}}",
          "onClick": [
            { "action": "nextCard" },
            { "action": "confetti", "preset": "confettiMini" }
          ]
        },
        {
          "id": "btn-reason-continue",
          "type": "button",
          "variant": "primary",
          "label": "See Memories",
          "iconRight": "chevron-right",
          "showWhen": "{{currentIndex === total - 1}}",
          "onClick": [{ "action": "navigate", "target": "next" }]
        },
        {
          "id": "btn-reason-back",
          "type": "link",
          "label": "← Back to Letter",
          "onClick": [{ "action": "navigate", "target": "prev" }]
        }
      ]
    },

    {
      "id": "page-5",
      "pageNumber": 5,
      "key": "memories",
      "label": "Memories",
      "component": "Timeline",
      "showInProgress": true,
      "transition": {
        "enter": { "type": "slide", "initialY": 20, "duration": 0.5 },
        "exit":  { "type": "slide", "exitY": -20,  "duration": 0.5 }
      },
      "layout": { "alignment": "start", "direction": "column", "gap": "1.25rem" },
      "content": {
        "badge":   { "text": "Our Story",   "style": "pill" },
        "heading": { "text": "Our Journey", "fontFamily": "serif" },
        "caption": { "text": "Milestones of our beautiful bond ❤️" },
        "timeline": {
          "data": "{{gallery}}",
          "maxItems": 4,
          "lineColor": "#fda4af",
          "lineWidth": "2px",
          "dotColor": "#e11d48",
          "dotSize": "1rem",
          "dotBorder": "#ffffff",
          "itemAnimation": {
            "type": "slide",
            "x": 20,
            "delayStep": 0.1
          },
          "showDate": true,
          "showCaption": true,
          "dateStyle": "pill",
          "dateIcon": "calendar",
          "captionStyle": "italic"
        }
      },
      "actions": [
        {
          "id": "btn-memories-next",
          "type": "button",
          "variant": "primary",
          "label": "Photo Gallery →",
          "onClick": [{ "action": "navigate", "target": "next" }]
        },
        {
          "id": "btn-memories-back",
          "type": "button",
          "variant": "secondary",
          "label": "← Back",
          "onClick": [{ "action": "navigate", "target": "prev" }]
        }
      ]
    },

    {
      "id": "page-6",
      "pageNumber": 6,
      "key": "gallery",
      "label": "Gallery",
      "component": "Gallery",
      "showInProgress": true,
      "transition": {
        "enter": { "type": "slide", "initialY": 20, "duration": 0.5 },
        "exit":  { "type": "slide", "exitY": -20,  "duration": 0.5 }
      },
      "layout": { "alignment": "center", "direction": "column", "gap": "1.25rem" },
      "content": {
        "badge":   { "text": "Precious Moments", "style": "pill" },
        "heading": { "text": "Our Memories", "fontFamily": "serif", "icon": "image" },
        "hint":    { "text": "Tap any photo to enlarge" },
        "grid": {
          "data": "{{gallery}}",
          "columns": 2,
          "gap": "0.75rem",
          "maxHeight": "55vh",
          "scrollable": true,
          "itemShape": "square",
          "itemRadius": "0.75rem",
          "itemBorder": "#fecdd3",
          "itemShadow": "0 4px 12px rgba(225,29,72,0.10)",
          "hoverScale": 1.03,
          "tapScale": 0.97,
          "overlay": {
            "gradient": "from-rose-950/90 via-rose-950/20 to-transparent",
            "showDate": true,
            "showCaption": true,
            "dateIcon": "calendar",
            "captionLines": 2
          },
          "lightbox": {
            "enabled": true,
            "background": "rgba(0,0,0,0.90)",
            "blur": "12px",
            "animation": "fade"
          }
        }
      },
      "actions": [
        {
          "id": "btn-gallery-next",
          "type": "button",
          "variant": "primary",
          "label": "Music 🎵 →",
          "onClick": [{ "action": "navigate", "target": "next" }]
        },
        {
          "id": "btn-gallery-back",
          "type": "button",
          "variant": "secondary",
          "label": "← Back",
          "onClick": [{ "action": "navigate", "target": "prev" }]
        }
      ]
    },

    {
      "id": "page-7",
      "pageNumber": 7,
      "key": "music",
      "label": "Music",
      "component": "Music",
      "showInProgress": true,
      "transition": {
        "enter": { "type": "slide", "initialX": 20, "duration": 0.5 },
        "exit":  { "type": "slide", "exitX": -20,  "duration": 0.5 }
      },
      "layout": { "alignment": "center", "direction": "column", "gap": "1.25rem" },
      "content": {
        "badge":   { "text": "🎵 Our Song", "style": "pill" },
        "heading": { "text": "Background Serenade", "fontFamily": "serif" },
        "player": {
          "track": "{{music}}",
          "glassmorphism": true,
          "playButton": {
            "shape": "circle",
            "size": "3.5rem",
            "background": "#e11d48",
            "hoverBackground": "#be123c",
            "shadow": "0 8px 24px rgba(225,29,72,0.35)",
            "iconColor": "#ffffff",
            "iconSize": 22
          },
          "trackName": {
            "variable": "{{music.name}}",
            "fallback": "Love Melody",
            "truncate": true,
