# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLIENT_ID: Required for Google Sign-In (OAuth).
# Create one at https://console.cloud.google.com/ → APIs & Services → Credentials
# → Create OAuth 2.0 Client ID (Web application)
# Authorised JavaScript origins: https://your-app.onrender.com
# Authorised redirect URIs: not needed (we use the GIS token flow, not redirect flow)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Used for signing authentication tokens.
JWT_SECRET="lovelink_secret_key_change_me_in_prod"

# ADMIN_USERNAME / ADMIN_PASSWORD: credentials for the Admin Panel login form.
# Set both to secure values. ADMIN_USERNAME defaults to "admin" if unset.
# ADMIN_PASSCODE is kept for backward-compatibility; ADMIN_PASSWORD takes priority when set.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose_a_strong_password"
ADMIN_PASSCODE=""

# Cloudinary: used for storing uploaded photos and music files.
# Get these from your Cloudinary dashboard: https://console.cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# PORT: Render sets this automatically; only needed for local overrides.
PORT=3000

# NODE_ENV: set to "production" in deployed environments (Render sets this via render.yaml).
NODE_ENV=development

# DATA_DIR: folder where data.json (users/surprises) is stored. On Render this should
# point at the mounted persistent disk (see render.yaml) so data survives redeploys.
# Leave unset for local development — it defaults to the project folder.
DATA_DIR=
